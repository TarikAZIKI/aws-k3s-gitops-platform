# Managed by Ansible. Installed by the k3s built-in Helm controller.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: argocd
  namespace: kube-system
spec:
  repo: https://argoproj.github.io/argo-helm
  chart: argo-cd
  version: "{{ argocd_chart_version }}"
  targetNamespace: argocd
  createNamespace: true
  valuesContent: |-
    # SSO is not used: the UI is only reached through kubectl port-forward.
    dex:
      enabled: false
